{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "sc1m",
  "homepage": "https://sc1m.vercel.app",
  "items": [
    {
      "name": "tokens",
      "type": "registry:theme",
      "title": "sc1m Design Tokens",
      "description": "Ledger brand tokens and the Tailwind v4 theme contract: semantic colors, radii, shadows, motion, dark mode via the .dark class, and the popup-motion utility.",
      "cssVars": {
        "theme": {
          "--color-bg": "var(--bg)",
          "--color-surface": "var(--surface)",
          "--color-surface-raised": "var(--surface-raised)",
          "--color-fg": "var(--fg)",
          "--color-fg-muted": "var(--fg-muted)",
          "--color-fg-subtle": "var(--fg-subtle)",
          "--color-line": "var(--line)",
          "--color-line-strong": "var(--line-strong)",
          "--color-accent": "var(--accent)",
          "--color-accent-hover": "var(--accent-hover)",
          "--color-accent-fg": "var(--accent-fg)",
          "--color-highlight": "var(--highlight)",
          "--color-highlight-fg": "var(--highlight-fg)",
          "--color-success": "var(--success)",
          "--color-danger": "var(--danger)",
          "--color-danger-fg": "var(--danger-fg)",
          "--color-info": "var(--info)",
          "--color-ring": "var(--ring)",
          "--font-sans": "var(--brand-font-sans, var(--font-geist-sans, ui-sans-serif))",
          "--font-mono": "var(--brand-font-mono, var(--font-geist-mono, ui-monospace))",
          "--radius-sm": "var(--brand-radius-sm, 0.25rem)",
          "--radius-md": "var(--brand-radius-md, 0.375rem)",
          "--radius-lg": "var(--brand-radius-lg, 0.5rem)",
          "--radius-xl": "var(--brand-radius-xl, 0.75rem)",
          "--shadow-raised": "var(--brand-shadow-raised, 0 1px 2px 0 rgb(0 0 0 / 0.05))",
          "--shadow-overlay": "var(--brand-shadow-overlay, 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1))",
          "--ease-out-quad": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
          "--duration-fast": "150ms"
        }
      },
      "css": {
        "@custom-variant dark (&:where(.dark, .dark *))": {},
        ":root": {
          "--n-0": "#eceae6",
          "--n-50": "#f7f6f4",
          "--n-100": "#ececea",
          "--n-200": "#e6e4e0",
          "--n-300": "#dcdad6",
          "--n-400": "#a5a5a5",
          "--n-500": "#8a8a8a",
          "--n-700": "#5a5a5a",
          "--n-900": "#252017",
          "--brand-ink": "#252017",
          "--brand-accent": "#fcc305",
          "--brand-paper": "#ffffff",
          "--money-in": "#0f7a45",
          "--money-out": "#cf3a2c",
          "--ai-blue": "#1f6feb",
          "--bg": "var(--brand-paper)",
          "--surface": "var(--n-50)",
          "--surface-raised": "var(--brand-paper)",
          "--fg": "var(--n-900)",
          "--fg-muted": "var(--n-700)",
          "--fg-subtle": "var(--n-500)",
          "--line": "var(--n-200)",
          "--line-strong": "var(--n-300)",
          "--accent": "var(--brand-ink)",
          "--accent-hover": "#3d372d",
          "--accent-fg": "var(--brand-paper)",
          "--highlight": "var(--brand-accent)",
          "--highlight-fg": "#252017",
          "--ring": "var(--brand-ink)",
          "--success": "var(--money-in)",
          "--danger": "var(--money-out)",
          "--danger-fg": "#ffffff",
          "--info": "var(--ai-blue)",
          "--brand-radius-sm": "5px",
          "--brand-radius-md": "10px",
          "--brand-radius-lg": "14px",
          "--brand-radius-xl": "22px",
          "--brand-font-sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "--brand-font-mono": "ui-monospace, Menlo, monospace",
          "--acc-expand": "250ms",
          "--acc-collapse": "250ms",
          "--acc-chevron": "250ms",
          "--acc-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--popup-open-dur": "250ms",
          "--popup-close-dur": "150ms",
          "--popup-pre-scale": "0.97",
          "--popup-closing-scale": "0.99",
          "--popup-ease": "cubic-bezier(0.22, 1, 0.36, 1)"
        },
        ".dark": {
          "--n-0": "#14120e",
          "--n-50": "#1e1b16",
          "--n-100": "#26221b",
          "--n-200": "#302b23",
          "--n-300": "#3d372d",
          "--n-400": "#6d6963",
          "--n-500": "#918d85",
          "--n-700": "#bab6ae",
          "--n-900": "#f4f2ee",
          "--brand-ink": "#ffffff",
          "--brand-paper": "#14120e",
          "--money-in": "#3fbc7a",
          "--money-out": "#ff7a6b",
          "--ai-blue": "#6fa4ff",
          "--surface-raised": "var(--n-100)",
          "--accent-hover": "#dcdad6",
          "--accent-fg": "#252017",
          "--danger-fg": "#14120e"
        },
        "@utility popup-motion": {
          "transform-origin": "var(--transform-origin)",
          "transition-property": "opacity, scale",
          "transition-duration": "var(--popup-close-dur)",
          "transition-timing-function": "var(--popup-ease)",
          "will-change": "opacity, scale",
          "&[data-open]": {
            "transition-duration": "var(--popup-open-dur)"
          },
          "&[data-starting-style]": {
            "scale": "var(--popup-pre-scale)",
            "opacity": "0"
          },
          "&[data-ending-style]": {
            "scale": "var(--popup-closing-scale)",
            "opacity": "0"
          },
          "@media (prefers-reduced-motion: reduce)": {
            "transition": "none"
          }
        },
        "@keyframes toast-nudge": {
          "50%": {
            "scale": "1.05"
          }
        },
        ".toast-nudge": {
          "animation": "toast-nudge 300ms var(--popup-ease)"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".toast-nudge": {
            "animation": "none"
          }
        }
      },
      "docs": "sc1m tokens installed. App-level setup: (1) dark mode toggles via the .dark class on <html> (next-themes compatible); (2) wrap app content in a container with `isolation: isolate` so Base UI portalled popups stack above it; (3) keep `position: relative` on <body> for correct Base UI backdrop behavior in iOS Safari 26+; (4) additional brands scope tokens under [data-brand=\"…\"] on <html>."
    },
    {
      "name": "cn",
      "type": "registry:lib",
      "title": "cn Utility",
      "description": "Class-name combiner: clsx + tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/lib/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "switch",
      "type": "registry:ui",
      "title": "Switch",
      "description": "A toggle switch built on Base UI, styled with sc1m tokens.",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": [
        "https://sc1m.vercel.app/r/tokens.json",
        "https://sc1m.vercel.app/r/cn.json"
      ],
      "files": [
        {
          "path": "src/components/ui/switch/switch.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
